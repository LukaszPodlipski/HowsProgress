NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Web client (Firebase → Authentication → Google)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web client secret — required for Tauri PKCE token exchange
# Google Cloud → Web client → Client secrets → Add secret
NUXT_PUBLIC_GOOGLE_CLIENT_SECRET=

# Add to Web client Authorized redirect URIs:
#   http://127.0.0.1:42819
